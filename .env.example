# The Hub: alle Werte nur hier bzw. in /opt/hub/.env auf dem Server, nie im Code.

# Gemeinsames Login-Passwort fuer alle Nutzer des Hubs
HUB_PASSWORD=

# Token, mit dem der Hub den Programm-Tracker in Emil liest und schreibt.
# Derselbe Wert steht als HUB_TOKEN in Emils .env. Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HUB_TOKEN=

# Basis-URL von Emil, ohne Pfad (auf dem VPS: https://emil-manager.de)
EMIL_EXPORT_URL=

# Websuche fuer News und Hackathon-Suche (tavily.com, Free-Tier 1000 Credits/Monat)
TAVILY_API_KEY=

# Webseiten lesen: OpenAI-kompatible Claude-API (auf dem VPS die claude-code-api
# auf 127.0.0.1:8080, Token aus deren .env). Ohne beides ist das Lesen aus.
CLAUDE_API_URL=
CLAUDE_API_TOKEN=
CLAUDE_API_MODEL=claude-sonnet-5

# Tokens fuer Terminals und Agenten: "name:token,name:token". Erzeugen wie HUB_TOKEN.
HUB_AGENT_TOKENS=

# Server
PORT=8340
# 1 nur hinter Caddy: dann zaehlt der letzte Eintrag in X-Forwarded-For als Client-IP
VERTRAUE_PROXY=0
# Ablage fuer Eintraege, Sessions und Logos (Standard: ./data)
HUB_DATA_DIR=
